generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// AUTH - Synced from Supabase auth.users via database trigger
// ============================================================

model Profile {
  id           String   @id @db.Uuid
  email        String   @unique
  fullName     String?  @map("full_name")
  avatarUrl    String?  @map("avatar_url")
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  signatureUrl String?  @map("signature_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  documents Document[]

  @@map("profiles")
}

// ============================================================
// COMPANY MASTER
// ============================================================

model Company {
  id      String @id @default(cuid())
  name    String
  address String @db.Text
  taxId   String? @map("tax_id")
  phone   String?
  email   String?

  facebook  String?
  instagram String?
  lineOa    String? @map("line_oa")
  tiktok    String?
  logoUrl   String? @map("logo_url")

  bankName      String? @map("bank_name")
  accountName   String? @map("account_name")
  accountNumber  String? @map("account_number")
  bankLogoUrl    String? @map("bank_logo_url")
  promptpayQrUrl String? @map("promptpay_qr_url")

  vatEnabled  Boolean @default(true) @map("vat_enabled")
  vatRate     Decimal @default(7) @map("vat_rate") @db.Decimal(5, 2)
  footerNotes String? @map("footer_notes") @db.Text

  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  documents Document[]

  @@map("companies")
}

// ============================================================
// PRODUCT
// ============================================================

model ProductCategory {
  id         String   @id @default(cuid())
  name       String   @unique
  prefix     String?  @unique
  lastNumber Int      @default(0) @map("last_number")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("product_categories")
}

model Product {
  id          String  @id @default(cuid())
  sku         String  @unique
  name        String
  description String? @db.Text
  imageUrl    String? @map("image_url")

  width    Decimal? @db.Decimal(10, 2)
  height   Decimal? @db.Decimal(10, 2)
  sizeUnit String?  @default("cm") @map("size_unit")

  basePrice Decimal @map("base_price") @db.Decimal(12, 2)

  // Cost tracking fields (CNY)
  costPrice          Decimal? @map("cost_price") @db.Decimal(12, 2)
  exchangeRate       Decimal? @map("exchange_rate") @db.Decimal(10, 4)
  weightPerBox       Decimal? @map("weight_per_box") @db.Decimal(10, 2)
  shippingCostPerBox Decimal? @map("shipping_cost_per_box") @db.Decimal(12, 2)

  categoryId String?          @map("category_id")
  category   ProductCategory? @relation(fields: [categoryId], references: [id])

  woocommerceId Int?          @unique @map("woocommerce_id")
  source        ProductSource @default(MANUAL)

  // Stock tracking
  stockQuantity     Int @default(0) @map("stock_quantity")
  lowStockThreshold Int @default(5) @map("low_stock_threshold")

  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stockMovements StockMovement[]
  colorVariants  ProductColorVariant[]

  @@map("products")
}

// ============================================================
// CUSTOMER
// ============================================================

model Customer {
  id            String       @id @default(cuid())
  code          String       @unique @map("customer_code")
  type          CustomerType
  companyName   String?      @map("company_name")
  customerName  String       @map("customer_name")
  contactPerson String?      @map("contact_person")
  taxId         String?      @map("tax_id")
  address       String?      @db.Text
  phone         String?
  email         String?
  leadType      LeadType?    @map("lead_type")
  leadName      String?      @map("lead_name")
  notes         String?      @db.Text

  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  documents Document[]

  @@map("customers")
}

// ============================================================
// DOCUMENT
// ============================================================

model DocumentCounter {
  id        String       @id @default(cuid())
  type      DocumentType
  yearMonth String       @map("year_month")
  counter   Int          @default(0)

  @@unique([type, yearMonth])
  @@map("document_counters")
}

model Document {
  id             String         @id @default(cuid())
  type           DocumentType
  documentNumber       String         @unique @map("document_number")
  customInvoiceNumber  String?        @map("custom_invoice_number")
  status               DocumentStatus @default(DRAFT)
  documentDate         DateTime       @map("document_date") @db.Date

  companyId       String @map("company_id")
  company         Company @relation(fields: [companyId], references: [id])
  companySnapshot Json    @map("company_snapshot")

  customerId       String   @map("customer_id")
  customer         Customer @relation(fields: [customerId], references: [id])
  customerSnapshot Json     @map("customer_snapshot")

  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  discountType   DiscountType? @map("discount_type")
  discountValue  Decimal?      @map("discount_value") @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  vatEnabled     Boolean       @default(true) @map("vat_enabled")
  vatRate        Decimal       @default(7) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount      Decimal       @default(0) @map("vat_amount") @db.Decimal(12, 2)
  shippingCost   Decimal       @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  grandTotal     Decimal       @default(0) @map("grand_total") @db.Decimal(12, 2)

  footerNotes       String?   @map("footer_notes") @db.Text
  productionDays    String?   @map("production_days")
  productionDaysMin Int?      @map("production_days_min")
  productionDaysMax Int?      @map("production_days_max")
  skipWeekends      Boolean   @default(false) @map("skip_weekends")
  skipHolidays      Boolean   @default(false) @map("skip_holidays")
  deliveryDateStart      DateTime? @map("delivery_date_start") @db.Date
  deliveryDateEnd        DateTime? @map("delivery_date_end") @db.Date
  deliveryCompletedDate  DateTime? @map("delivery_completed_date") @db.Date
  paymentDate            DateTime? @map("payment_date") @db.Date

  createdById String  @map("created_by_id") @db.Uuid
  createdBy   Profile @relation(fields: [createdById], references: [id])

  sourceQuotationId String?    @map("source_quotation_id")
  sourceQuotation   Document?  @relation("InvoiceFromQuotation", fields: [sourceQuotationId], references: [id])
  invoices          Document[] @relation("InvoiceFromQuotation")

  sourceInvoiceId String?    @map("source_invoice_id")
  sourceInvoice   Document?  @relation("ReceiptFromInvoice", fields: [sourceInvoiceId], references: [id])
  receipts        Document[] @relation("ReceiptFromInvoice")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lineItems    DocumentLineItem[]
  paymentTerms DocumentPaymentTerm[]
  vendorCosts  VendorCost[]

  @@index([type, status])
  @@index([documentDate])
  @@index([customerId])
  @@index([companyId])
  @@map("documents")
}

model DocumentLineItem {
  id         String   @id @default(cuid())
  documentId String   @map("document_id")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  sequence         Int
  productSku       String?  @map("product_sku")
  productName      String   @map("product_name")
  productImage     String?  @map("product_image")
  colorVariantName String?  @map("color_variant_name")
  showImage        Boolean  @default(false) @map("show_image")
  details          String?  @db.Text
  quantity     Int
  unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 2)
  lineTotal    Decimal  @map("line_total") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([documentId])
  @@map("document_line_items")
}

model DocumentPaymentTerm {
  id         String   @id @default(cuid())
  documentId String   @map("document_id")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  sequence         Int
  name             String
  type             PaymentTermType
  value            Decimal @db.Decimal(12, 2)
  calculatedAmount Decimal @map("calculated_amount") @db.Decimal(12, 2)
  note             String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([documentId])
  @@map("document_payment_terms")
}

// ============================================================
// PAYMENT TERM TEMPLATE
// ============================================================

model PaymentTermTemplate {
  id     String @id @default(cuid())
  name   String
  status Status @default(ACTIVE)

  items     PaymentTermTemplateItem[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("payment_term_templates")
}

model PaymentTermTemplateItem {
  id         String              @id @default(cuid())
  templateId String              @map("template_id")
  template   PaymentTermTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  sequence Int
  name     String
  type     PaymentTermType
  value    Decimal  @db.Decimal(12, 2)
  note     String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([templateId])
  @@map("payment_term_template_items")
}

// ============================================================
// HOLIDAY
// ============================================================

model Holiday {
  id          String   @id @default(cuid())
  name        String
  date        DateTime @db.Date
  isRecurring Boolean  @default(false) @map("is_recurring")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@map("holidays")
}

// ============================================================
// MONTHLY EXPENSES
// ============================================================

model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id            String         @id @default(cuid())
  name          String
  amount        Decimal        @db.Decimal(12, 2)
  expenseDate   DateTime       @map("expense_date") @db.Date
  categoryId    String         @map("category_id")
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  paymentMethod PaymentMethod  @default(TRANSFER) @map("payment_method")
  notes         String?        @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([expenseDate])
  @@map("expenses")
}

// ============================================================
// VENDOR COST TRACKING
// ============================================================

model VendorCost {
  id            String        @id @default(cuid())
  documentId    String?       @map("document_id")
  document      Document?     @relation(fields: [documentId], references: [id])
  vendorName    String        @map("vendor_name")
  orderNumber   String?       @map("order_number")
  orderDate     DateTime      @map("order_date") @db.Date
  exchangeRate  Decimal?      @map("exchange_rate") @db.Decimal(10, 4)
  shippingCost  Decimal       @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  otherCost     Decimal       @default(0) @map("other_cost") @db.Decimal(12, 2)
  totalCost     Decimal       @default(0) @map("total_cost") @db.Decimal(12, 2)
  shippingProvider            String    @default("UNEED_CARGO") @map("shipping_provider")
  paymentMethod               PaymentMethod @default(TRANSFER) @map("payment_method")
  paymentMethodNote           String?       @map("payment_method_note")
  shippingPaymentMethod       PaymentMethod @default(TRANSFER) @map("shipping_payment_method")
  shippingPaymentMethodNote   String?       @map("shipping_payment_method_note")
  notes                       String?       @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items VendorCostItem[]

  @@index([documentId])
  @@index([orderDate])
  @@map("vendor_costs")
}

model VendorCostItem {
  id           String     @id @default(cuid())
  vendorCostId String     @map("vendor_cost_id")
  vendorCost   VendorCost @relation(fields: [vendorCostId], references: [id], onDelete: Cascade)

  sequence      Int
  productName   String  @map("product_name")
  productSku    String? @map("product_sku")
  productImage  String? @map("product_image")
  quantity      Int
  unitCostCny   Decimal? @map("unit_cost_cny") @db.Decimal(12, 2)
  unitCostRate  Decimal? @map("unit_cost_rate") @db.Decimal(10, 4)
  unitCost      Decimal  @map("unit_cost") @db.Decimal(12, 2)
  lineTotal     Decimal  @map("line_total") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([vendorCostId])
  @@map("vendor_cost_items")
}

// ============================================================
// ENUMS
// ============================================================

enum Status {
  ACTIVE
  INACTIVE
}

enum CustomerType {
  COMPANY
  INDIVIDUAL
}

enum LeadType {
  FACEBOOK
  INSTAGRAM
  LINE_OA
  TIKTOK
  WEBSITE
  REFERRAL
  OTHER
}

enum DocumentType {
  QUOTATION
  INVOICE
  RECEIPT
}

enum DocumentStatus {
  DRAFT
  QUOTED
  CONFIRMED
  SHIPPED
  SAMPLE
  BILLED
  PAID
  DEPOSITED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  AMOUNT
}

enum PaymentTermType {
  PERCENTAGE
  AMOUNT
}

enum ProductSource {
  MANUAL
  WOOCOMMERCE
}

enum SyncStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum SyncTrigger {
  MANUAL
  SCHEDULED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CREDIT_CARD
  PROMPTPAY
  OTHER
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  INITIAL
}

// ============================================================
// STOCK MANAGEMENT
// ============================================================

model ProductColorVariant {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name      String
  colorHex  String?  @map("color_hex")
  imageUrl  String?  @map("image_url")
  price     Decimal? @db.Decimal(12, 2)
  sortOrder Int      @default(0) @map("sort_order")

  stockQuantity     Int @default(0) @map("stock_quantity")
  lowStockThreshold Int @default(5) @map("low_stock_threshold")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stockMovements StockMovement[]

  @@unique([productId, name])
  @@index([productId])
  @@map("product_color_variants")
}

model StockMovement {
  id        String            @id @default(cuid())
  productId String            @map("product_id")
  product   Product           @relation(fields: [productId], references: [id])

  colorVariantId String?              @map("color_variant_id")
  colorVariant   ProductColorVariant? @relation(fields: [colorVariantId], references: [id])

  type         StockMovementType
  quantity     Int
  reason       String?           @db.Text
  reference    String?
  lotNumber    String?           @map("lot_number")
  balanceAfter Int               @map("balance_after")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([colorVariantId])
  @@index([createdAt])
  @@map("stock_movements")
}

// ============================================================
// WOOCOMMERCE INTEGRATION
// ============================================================

model WooCommerceConfig {
  id              String   @id @default(cuid())
  storeUrl        String   @map("store_url")
  consumerKey     String   @map("consumer_key")
  consumerSecret  String   @map("consumer_secret")
  autoSyncEnabled Boolean  @default(false) @map("auto_sync_enabled")
  lastSyncAt      DateTime? @map("last_sync_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  syncLogs WooCommerceSyncLog[]

  @@map("woocommerce_configs")
}

model WooCommerceSyncLog {
  id       String      @id @default(cuid())
  configId String      @map("config_id")
  config   WooCommerceConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  status       SyncStatus
  trigger      SyncTrigger
  totalFetched Int        @default(0) @map("total_fetched")
  created      Int        @default(0)
  updated      Int        @default(0)
  skipped      Int        @default(0)
  failed       Int        @default(0)
  errorMessage String?    @map("error_message") @db.Text

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@index([configId])
  @@index([startedAt])
  @@map("woocommerce_sync_logs")
}
