generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// AUTH - Synced from Supabase auth.users via database trigger
// ============================================================

model Profile {
  id           String   @id @db.Uuid
  email        String   @unique
  username     String?  @unique
  fullName     String?  @map("full_name")
  avatarUrl    String?  @map("avatar_url")
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  signatureUrl String?  @map("signature_url")
  role         UserRole @default(STAFF)
  status       Status   @default(ACTIVE)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  documents             Document[]
  customers             Customer[]      @relation("CustomerCreatedBy")
  products              Product[]       @relation("ProductCreatedBy")
  expenses              Expense[]       @relation("ExpenseCreatedBy")
  vendorCosts           VendorCost[]    @relation("VendorCostCreatedBy")
  stockMovements        StockMovement[] @relation("StockMovementCreatedBy")
  stockDocumentsCreated StockDocument[] @relation("StockDocumentCreatedBy")
  stockDocumentsPosted  StockDocument[] @relation("StockDocumentPostedBy")

  @@map("profiles")
}

// ============================================================
// COMPANY MASTER
// ============================================================

model Company {
  id      String @id @default(cuid())
  name    String
  address String @db.Text
  taxId   String? @map("tax_id")
  phone   String?
  email   String?

  facebook  String?
  instagram String?
  lineOa    String? @map("line_oa")
  tiktok    String?
  logoUrl   String? @map("logo_url")

  bankName      String? @map("bank_name")
  accountName   String? @map("account_name")
  accountNumber  String? @map("account_number")
  bankLogoUrl    String? @map("bank_logo_url")
  promptpayQrUrl String? @map("promptpay_qr_url")

  vatEnabled  Boolean @default(true) @map("vat_enabled")
  vatRate     Decimal @default(7) @map("vat_rate") @db.Decimal(5, 2)
  footerNotes String? @map("footer_notes") @db.Text

  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  documents Document[]

  @@map("companies")
}

// ============================================================
// PRINT ORDER SETTINGS
// Shared shop-info shown on the "print delivery note" (พิมพ์ใบส่งของ)
// page. Single row shared by everyone who prints delivery notes.
// ============================================================

model PrintOrderSettings {
  id        String   @id @default("default")
  address   String?  @db.Text
  phone     String?
  lineOa    String?  @map("line_oa")
  instagram String?
  facebook  String?
  tiktok    String?
  logoUrl   String?  @map("logo_url")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("print_order_settings")
}

// ============================================================
// PRODUCT
// ============================================================

model ProductCategory {
  id         String   @id @default(cuid())
  name       String   @unique
  prefix     String?  @unique
  lastNumber Int      @default(0) @map("last_number")
  sortOrder  Int      @default(0) @map("sort_order")
  websiteCategoryId Int? @unique @map("website_category_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("product_categories")
}

model Product {
  id          String  @id @default(cuid())
  sku         String  @unique
  name        String
  description String? @db.Text
  imageUrl    String? @map("image_url")

  width    Decimal? @db.Decimal(10, 2)
  height   Decimal? @db.Decimal(10, 2)
  sizeUnit String?  @default("cm") @map("size_unit")

  basePrice Decimal @map("base_price") @db.Decimal(12, 2)

  // Cost tracking fields (CNY)
  costPrice          Decimal? @map("cost_price") @db.Decimal(12, 2)
  exchangeRate       Decimal? @map("exchange_rate") @db.Decimal(10, 4)
  weightPerBox       Decimal? @map("weight_per_box") @db.Decimal(10, 2)
  shippingCostPerBox Decimal? @map("shipping_cost_per_box") @db.Decimal(12, 2)

  categoryId String?          @map("category_id")
  category   ProductCategory? @relation(fields: [categoryId], references: [id])

  /// LEGACY: WooCommerce post id, used once to match website products via wp_post_id.
  woocommerceId    Int?          @unique @map("woocommerce_id")
  source           ProductSource @default(MANUAL)

  // Website catalog sync (goodchoiceth.com) — website-owned, see src/lib/catalog/sync.ts
  websiteProductId Int?      @unique @map("website_product_id")
  websiteSlug      String?   @map("website_slug")
  websiteSpecs     Json?     @map("website_specs")
  websiteUpdatedAt DateTime? @map("website_updated_at")
  lastSyncedAt     DateTime? @map("last_synced_at")

  // Stock tracking
  stockQuantity     Int    @default(0) @map("stock_quantity")
  lowStockThreshold Int    @default(5) @map("low_stock_threshold")
  /// Immutable scan/label identity. Backfilled from sku, then never rewritten
  /// (independent of sku, which may change; catalog sync must never touch this).
  stockCode         String @unique @map("stock_code")

  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   Profile? @relation("ProductCreatedBy", fields: [createdById], references: [id])

  stockMovements     StockMovement[]
  colorVariants      ProductColorVariant[]
  documentLineItems  DocumentLineItem[]
  stockDocumentLines StockDocumentLine[]

  @@map("products")
}

// ============================================================
// CUSTOMER
// ============================================================

model Customer {
  id            String       @id @default(cuid())
  code          String       @unique @map("customer_code")
  type          CustomerType
  companyName   String?      @map("company_name")
  customerName  String       @map("customer_name")
  contactPerson String?      @map("contact_person")
  taxId         String?      @map("tax_id")
  address       String?      @db.Text
  phone         String?
  email         String?
  leadType      LeadType?    @map("lead_type")
  leadName      String?      @map("lead_name")
  notes         String?      @db.Text

  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   Profile? @relation("CustomerCreatedBy", fields: [createdById], references: [id])

  documents Document[]

  @@map("customers")
}

// ============================================================
// DOCUMENT
// ============================================================

model DocumentCounter {
  id        String       @id @default(cuid())
  type      DocumentType
  yearMonth String       @map("year_month")
  counter   Int          @default(0)

  @@unique([type, yearMonth])
  @@map("document_counters")
}

enum ReceiptPaymentType {
  FULL
  DEPOSIT
  BALANCE
}

model Document {
  id             String         @id @default(cuid())
  type           DocumentType
  documentNumber       String?        @unique @map("document_number")
  customInvoiceNumber  String?        @map("custom_invoice_number")
  status               DocumentStatus @default(DRAFT)
  documentDate         DateTime       @map("document_date") @db.Date

  companyId       String @map("company_id")
  company         Company @relation(fields: [companyId], references: [id])
  companySnapshot Json    @map("company_snapshot")

  customerId       String   @map("customer_id")
  customer         Customer @relation(fields: [customerId], references: [id])
  customerSnapshot Json     @map("customer_snapshot")

  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  discountType   DiscountType? @map("discount_type")
  discountValue  Decimal?      @map("discount_value") @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  vatEnabled     Boolean       @default(true) @map("vat_enabled")
  vatRate        Decimal       @default(7) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount      Decimal       @default(0) @map("vat_amount") @db.Decimal(12, 2)
  shippingCost         Decimal  @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  shippingLocation     String?  @map("shipping_location") @db.Text
  freeShipping         Boolean  @default(false) @map("free_shipping")
  freeShippingLocation String?  @map("free_shipping_location") @db.Text
  pickupAtShowroom     Boolean  @default(false) @map("pickup_at_showroom")
  grandTotal     Decimal       @default(0) @map("grand_total") @db.Decimal(12, 2)

  /// Deposit VAT invoice: a normal INVOICE flagged as a deposit, carrying one
  /// generated line for the deposit amount, whose documentNumber is a
  /// manually-typed tax-invoice number instead of the auto INV-YYMM-NNNN.
  isDepositInvoice Boolean  @default(false) @map("is_deposit_invoice")
  depositPercent   Decimal? @map("deposit_percent") @db.Decimal(5, 2)
  /// Sum of deposit invoices (or manual rows) deducted on this document, and
  /// grandTotal - depositDeduction. netPayable is always populated (equals
  /// grandTotal when there is no deduction) so it can be summed for revenue.
  depositDeduction Decimal  @default(0) @map("deposit_deduction") @db.Decimal(12, 2)
  netPayable       Decimal  @default(0) @map("net_payable") @db.Decimal(12, 2)

  depositDeductions DocumentDepositDeduction[] @relation("DepositDeductionOnDocument")
  deductedOn        DocumentDepositDeduction[] @relation("DepositDeductedBy")

  footerNotes       String?   @map("footer_notes") @db.Text
  productionDays    String?   @map("production_days")
  productionDaysMin Int?      @map("production_days_min")
  productionDaysMax Int?      @map("production_days_max")
  skipWeekends      Boolean   @default(false) @map("skip_weekends")
  skipHolidays      Boolean   @default(false) @map("skip_holidays")
  deliveryDateStart      DateTime? @map("delivery_date_start") @db.Date
  deliveryDateEnd        DateTime? @map("delivery_date_end") @db.Date
  deliveryCompletedDate  DateTime? @map("delivery_completed_date") @db.Date
  paymentDate            DateTime? @map("payment_date") @db.Date

  createdById String  @map("created_by_id") @db.Uuid
  createdBy   Profile @relation(fields: [createdById], references: [id])

  sourceQuotationId String?    @map("source_quotation_id")
  sourceQuotation   Document?  @relation("InvoiceFromQuotation", fields: [sourceQuotationId], references: [id])
  invoices          Document[] @relation("InvoiceFromQuotation")

  receiptPaymentType ReceiptPaymentType? @map("receipt_payment_type")
  receiptPaymentSummary Json? @map("receipt_payment_summary")

  sourceInvoiceId String?    @map("source_invoice_id")
  sourceInvoice   Document?  @relation("ReceiptFromInvoice", fields: [sourceInvoiceId], references: [id])
  receipts        Document[] @relation("ReceiptFromInvoice")

  /// Set true the first time this document is confirmed under the reservation
  /// system (see src/data/stock-availability.ts). Documents confirmed before
  /// this feature shipped stay false — they already deducted stock the old
  /// way and are treated as already issued, not re-reserved. Re-confirming
  /// an old document is the escape hatch to opt it in.
  reservesStock Boolean @default(false) @map("reserves_stock")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lineItems        DocumentLineItem[]
  paymentTerms     DocumentPaymentTerm[]
  vendorCosts      VendorCost[]
  stockIssues      StockDocument[]       @relation("StockIssueForDocument")

  @@index([type, status])
  @@index([documentDate])
  @@index([customerId])
  @@index([companyId])
  @@index([sourceInvoiceId])
  @@map("documents")
}

model DocumentLineItem {
  id         String   @id @default(cuid())
  documentId String   @map("document_id")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  sequence         Int
  productSku       String?  @map("product_sku")
  productName      String   @map("product_name")
  productImage     String?  @map("product_image")
  colorVariantName String?  @map("color_variant_name")
  colorVariantSku  String?  @map("color_variant_sku")
  showImage        Boolean  @default(false) @map("show_image")
  details          String?  @db.Text
  quantity     Int
  unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 2)
  lineTotal    Decimal  @map("line_total") @db.Decimal(12, 2)

  /// Stable identity backing reservation/issue matching. Nullable: legacy rows
  /// backfilled by (sku) / (productId, name); may stay null when unmatched
  /// (deleted product, renamed colour before backfill).
  productId      String?              @map("product_id")
  product        Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  colorVariantId String?              @map("color_variant_id")
  colorVariant   ProductColorVariant? @relation(fields: [colorVariantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stockDocumentLines StockDocumentLine[]

  @@index([documentId])
  @@index([productId])
  @@index([colorVariantId])
  @@map("document_line_items")
}

model DocumentPaymentTerm {
  id         String   @id @default(cuid())
  documentId String   @map("document_id")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  sequence         Int
  name             String
  type             PaymentTermType
  value            Decimal @db.Decimal(12, 2)
  calculatedAmount Decimal @map("calculated_amount") @db.Decimal(12, 2)
  note             String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([documentId])
  @@map("document_payment_terms")
}

model DocumentDepositDeduction {
  id         String   @id @default(cuid())
  documentId String   @map("document_id")
  document   Document @relation("DepositDeductionOnDocument", fields: [documentId], references: [id], onDelete: Cascade)

  sequence          Int
  /// Nullable: a deposit invoiced outside GCOffice is deducted as a manual
  /// row with no link, using the typed amount as-is.
  depositDocumentId String?   @map("deposit_document_id")
  depositDocument   Document? @relation("DepositDeductedBy", fields: [depositDocumentId], references: [id])
  label             String
  taxInvoiceNumber  String?   @map("tax_invoice_number")
  amount            Decimal   @db.Decimal(12, 2)
  depositDate       DateTime? @map("deposit_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([documentId])
  @@map("document_deposit_deductions")
}

// ============================================================
// PAYMENT TERM TEMPLATE
// ============================================================

model PaymentTermTemplate {
  id     String @id @default(cuid())
  name   String
  status Status @default(ACTIVE)

  items     PaymentTermTemplateItem[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("payment_term_templates")
}

model PaymentTermTemplateItem {
  id         String              @id @default(cuid())
  templateId String              @map("template_id")
  template   PaymentTermTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  sequence Int
  name     String
  type     PaymentTermType
  value    Decimal  @db.Decimal(12, 2)
  note     String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([templateId])
  @@map("payment_term_template_items")
}

// ============================================================
// HOLIDAY
// ============================================================

model Holiday {
  id          String   @id @default(cuid())
  name        String
  date        DateTime @db.Date
  isRecurring Boolean  @default(false) @map("is_recurring")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@map("holidays")
}

// ============================================================
// MONTHLY EXPENSES
// ============================================================

model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id            String         @id @default(cuid())
  name          String
  amount        Decimal        @db.Decimal(12, 2)
  expenseDate   DateTime       @map("expense_date") @db.Date
  categoryId    String         @map("category_id")
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  paymentMethod PaymentMethod  @default(TRANSFER) @map("payment_method")
  notes         String?        @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   Profile? @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  @@index([categoryId])
  @@index([expenseDate])
  @@map("expenses")
}

// ============================================================
// VENDOR COST TRACKING
// ============================================================

model VendorCost {
  id            String        @id @default(cuid())
  documentId    String?       @map("document_id")
  document      Document?     @relation(fields: [documentId], references: [id])
  vendorName    String        @map("vendor_name")
  orderNumber   String?       @map("order_number")
  orderDate     DateTime      @map("order_date") @db.Date
  exchangeRate  Decimal?      @map("exchange_rate") @db.Decimal(10, 4)
  shippingCost  Decimal       @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  otherCost     Decimal       @default(0) @map("other_cost") @db.Decimal(12, 2)
  totalCost     Decimal       @default(0) @map("total_cost") @db.Decimal(12, 2)
  shippingProvider            String    @default("UNEED_CARGO") @map("shipping_provider")
  paymentMethod               PaymentMethod @default(TRANSFER) @map("payment_method")
  paymentMethodNote           String?       @map("payment_method_note")
  shippingPaymentMethod       PaymentMethod @default(TRANSFER) @map("shipping_payment_method")
  shippingPaymentMethodNote   String?       @map("shipping_payment_method_note")
  notes                       String?       @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   Profile? @relation("VendorCostCreatedBy", fields: [createdById], references: [id])

  items VendorCostItem[]

  @@index([documentId])
  @@index([orderDate])
  @@map("vendor_costs")
}

model VendorCostItem {
  id           String     @id @default(cuid())
  vendorCostId String     @map("vendor_cost_id")
  vendorCost   VendorCost @relation(fields: [vendorCostId], references: [id], onDelete: Cascade)

  sequence      Int
  productName   String  @map("product_name")
  productSku    String? @map("product_sku")
  productImage  String? @map("product_image")
  quantity      Int
  unitCostCny   Decimal? @map("unit_cost_cny") @db.Decimal(12, 2)
  unitCostRate  Decimal? @map("unit_cost_rate") @db.Decimal(10, 4)
  unitCost      Decimal  @map("unit_cost") @db.Decimal(12, 2)
  lineTotal     Decimal  @map("line_total") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([vendorCostId])
  @@map("vendor_cost_items")
}

// ============================================================
// ENUMS
// ============================================================

enum Status {
  ACTIVE
  INACTIVE
}

enum UserRole {
  ADMIN
  STAFF
}

enum CustomerType {
  COMPANY
  INDIVIDUAL
}

enum LeadType {
  FACEBOOK
  INSTAGRAM
  LINE_OA
  TIKTOK
  WEBSITE
  REFERRAL
  OTHER
}

enum DocumentType {
  QUOTATION
  INVOICE
  RECEIPT
}

enum DocumentStatus {
  DRAFT
  QUOTED
  CONFIRMED
  SHIPPED
  SAMPLE
  BILLED
  PAID
  DEPOSITED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  AMOUNT
}

enum PaymentTermType {
  PERCENTAGE
  AMOUNT
}

enum ProductSource {
  MANUAL
  WOOCOMMERCE
  WEBSITE
}

enum SyncStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum SyncTrigger {
  MANUAL
  SCHEDULED
  WEBHOOK
}

enum PaymentMethod {
  CASH
  TRANSFER
  CREDIT_CARD
  PROMPTPAY
  OTHER
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  INITIAL
}

// ============================================================
// STOCK MANAGEMENT
// ============================================================

model ProductColorVariant {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name      String
  colorHex  String?  @map("color_hex")
  imageUrl  String?  @map("image_url")
  price     Decimal? @db.Decimal(12, 2)
  sortOrder Int      @default(0) @map("sort_order")

  stockQuantity     Int    @default(0) @map("stock_quantity")
  lowStockThreshold Int    @default(5) @map("low_stock_threshold")
  /// Immutable scan/label identity: "<product.stockCode>#<nn>", nn assigned
  /// once at creation and never reused. Survives colour renames (name is
  /// website-owned and overwritten by catalog sync — see CLAUDE.md).
  stockCode         String @unique @map("stock_code")

  // Website catalog sync — website-owned when websiteVariantId is set
  sku                String?
  websiteVariantId   Int?     @unique @map("website_variant_id")
  websiteActive      Boolean  @default(true) @map("website_active")
  websiteStockStatus String?  @map("website_stock_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stockMovements     StockMovement[]
  documentLineItems  DocumentLineItem[]
  stockDocumentLines StockDocumentLine[]

  @@unique([productId, name])
  @@index([productId])
  @@map("product_color_variants")
}

model StockMovement {
  id        String            @id @default(cuid())
  productId String            @map("product_id")
  product   Product           @relation(fields: [productId], references: [id])

  colorVariantId String?              @map("color_variant_id")
  colorVariant   ProductColorVariant? @relation(fields: [colorVariantId], references: [id])

  type         StockMovementType
  quantity     Int
  reason       String?           @db.Text
  reference    String?
  lotNumber    String?           @map("lot_number")
  balanceAfter Int               @map("balance_after")

  stockDocumentId     String?            @map("stock_document_id")
  stockDocument       StockDocument?     @relation(fields: [stockDocumentId], references: [id])
  stockDocumentLineId String?            @map("stock_document_line_id")
  stockDocumentLine   StockDocumentLine? @relation(fields: [stockDocumentLineId], references: [id])

  /// Set on the compensating movement created when a POSTED stock document is
  /// cancelled. The @unique makes reversal idempotent at the database level —
  /// a second cancel attempt cannot double-reverse the same movement.
  reversesMovementId String?         @unique @map("reverses_movement_id")
  reversesMovement   StockMovement?  @relation("MovementReversal", fields: [reversesMovementId], references: [id])
  reversedBy         StockMovement?  @relation("MovementReversal")

  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   Profile? @relation("StockMovementCreatedBy", fields: [createdById], references: [id])

  @@index([productId])
  @@index([colorVariantId])
  @@index([createdAt])
  @@index([stockDocumentId])
  @@map("stock_movements")
}

// ============================================================
// STOCK DOCUMENTS (goods receive / goods issue / stock count)
// ============================================================

enum StockDocumentType {
  RECEIVE
  ISSUE
  COUNT
}

enum StockDocumentStatus {
  DRAFT
  POSTED
  CANCELLED
}

model StockDocumentCounter {
  id        String            @id @default(cuid())
  type      StockDocumentType
  yearMonth String            @map("year_month")
  counter   Int               @default(0)

  @@unique([type, yearMonth])
  @@map("stock_document_counters")
}

model StockDocument {
  id             String              @id @default(cuid())
  type           StockDocumentType
  documentNumber String              @unique @map("document_number")
  status         StockDocumentStatus @default(DRAFT)
  documentDate   DateTime            @map("document_date") @db.Date

  /// ISSUE against a quotation's outstanding line items; null = free-form issue
  sourceDocumentId String?   @map("source_document_id")
  sourceDocument   Document? @relation("StockIssueForDocument", fields: [sourceDocumentId], references: [id])

  note      String? @db.Text
  reference String? // supplier invoice / PO number / delivery note number
  lotNumber String? @map("lot_number")

  createdById String  @map("created_by_id") @db.Uuid
  createdBy   Profile @relation("StockDocumentCreatedBy", fields: [createdById], references: [id])

  postedAt   DateTime? @map("posted_at")
  postedById String?   @map("posted_by_id") @db.Uuid
  postedBy   Profile?  @relation("StockDocumentPostedBy", fields: [postedById], references: [id])

  cancelledAt   DateTime? @map("cancelled_at")
  cancelledById String?   @map("cancelled_by_id") @db.Uuid

  /// Set on the reversal document created when a POSTED document is cancelled.
  reversalOfId String?        @unique @map("reversal_of_id")
  reversalOf   StockDocument? @relation("StockDocReversal", fields: [reversalOfId], references: [id])
  reversedBy   StockDocument? @relation("StockDocReversal")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines     StockDocumentLine[]
  movements StockMovement[]

  @@index([type, status])
  @@index([documentDate])
  @@index([sourceDocumentId])
  @@map("stock_documents")
}

model StockDocumentLine {
  id              String        @id @default(cuid())
  stockDocumentId String        @map("stock_document_id")
  stockDocument   StockDocument @relation(fields: [stockDocumentId], references: [id], onDelete: Cascade)

  sequence Int

  productId      String               @map("product_id")
  product        Product              @relation(fields: [productId], references: [id])
  colorVariantId String?              @map("color_variant_id")
  colorVariant   ProductColorVariant? @relation(fields: [colorVariantId], references: [id])

  // Snapshots for printing/history even if the product is later renamed
  productSku       String  @map("product_sku")
  productName      String  @map("product_name")
  colorVariantName String? @map("color_variant_name")
  stockCode        String  @map("stock_code")

  /// RECEIVE: quantity received. ISSUE: quantity issued. COUNT: quantity counted.
  quantity Int
  /// COUNT only: on-hand at the moment the line was scanned (informational).
  systemQuantity Int? @map("system_quantity")

  /// ISSUE against a document: the DocumentLineItem this line fulfils.
  sourceLineItemId String?           @map("source_line_item_id")
  sourceLineItem   DocumentLineItem? @relation(fields: [sourceLineItemId], references: [id])
  /// ISSUE against a document: ordered qty snapshot, drives the tick-off UI.
  orderedQuantity  Int?              @map("ordered_quantity")

  lotNumber String? @map("lot_number")
  note      String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  movements StockMovement[]

  @@unique([stockDocumentId, productId, colorVariantId, sourceLineItemId])
  @@index([stockDocumentId])
  @@index([productId, colorVariantId])
  @@index([sourceLineItemId])
  @@map("stock_document_lines")
}

// ============================================================
// WEBSITE CATALOG SYNC (goodchoiceth.com -> GCOffice)
// ============================================================

model CatalogSyncLog {
  id      String      @id @default(cuid())
  status  SyncStatus
  trigger SyncTrigger
  /// "full" (all products, nightly/manual) | "products" (webhook, selected ids)
  scope   String      @default("full")
  dryRun  Boolean     @default(false) @map("dry_run")

  totalFetched Int @default(0) @map("total_fetched")
  created      Int @default(0)
  updated      Int @default(0)
  deactivated  Int @default(0)
  failed       Int @default(0)

  errorMessage String? @map("error_message") @db.Text
  /// Dry-run preview / per-run diagnostics (see CatalogSyncDetails in src/lib/catalog/sync.ts)
  details      Json?

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@index([startedAt])
  @@map("catalog_sync_logs")
}
