# Auto detect text files and perform LF normalization
* text=auto

# Force LF line endings for configuration files
*.toml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Prisma files should use LF
prisma/**/*.prisma text eol=lf
prisma/migrations/**/*.toml text eol=lf
prisma/migrations/**/*.sql text eol=lf

# Source code files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
